{
  "name": "apinoa-mcp",
  "version": "0.1.0",
  "description": "MCP server for apinoa: marketplace, social and image-translation data as tools for Claude, Cursor and any MCP client.",
  "license": "MIT",
  "homepage": "https://apinoa.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apinoahq/apinoa-mcp.git"
  },
  "bugs": "https://github.com/apinoahq/apinoa-mcp/issues",
  "keywords": ["mcp", "model-context-protocol", "apinoa", "amazon", "walmart", "shopify", "tiktok", "reddit", "youtube"],
  "type": "module",
  "bin": {
    "apinoa-mcp": "dist/cli.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node --test test/live/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "~5.7.3"
  }
}
